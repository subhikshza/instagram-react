rules_version = '2';

// Firebase Storage rules for the Instagram clone.
// Images are world-readable (they're shown in a public feed); a user may only
// write under their own folder.
service firebase.storage {
  match /b/{bucket}/o {
    match /posts/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
